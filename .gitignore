.env
data/index/
data/corpus/wiki/

# Dave core (dave/): secrets and runtime state.
dave/.env
dave/.claude-home/
dave/.run/
__pycache__/
# Dave's memories hold player data and this repo is public: only the README is tracked. Their versioned history
# is a git repo of its own (dave/memory/history.py, data/memory-history.git in dev), never this one.
data/memory/*
!data/memory/README.md
data/memory-history.git/
data/corpus/.wiki.*
data/wiki-git/
data/wiki-git.lock
data/wiki-review.jsonl
data/wiki-reports/
data/exports/
# Recipe database built by tools/recipe-export/run.sh (tools/recipes/build_db.py); baked read-only into the image.
data/recipes.sqlite
data/recipes.sqlite.tmp

# Downloads, extracted packs, trial state (large, regenerable)
.work/

# tuxmine/ (packs, deploy files, seed browser) is local-only: it names the real hosts. Untracked on
# purpose; build output lives in .work/tuxmine/.
/tuxmine/

# Generated source tree (1.7 GB, partly closed-source decompiles): regenerate with tools/decomp/. Only the
# indexes are versioned.
gtnh-src/*
!gtnh-src/INDEX.md
!gtnh-src/SOURCE-INDEX.md
!gtnh-src/source-index.json

# Agent worktrees
.claude/worktrees/

# Pack provenance stamps written by tools/packstate.py (which pack each baked artifact was built from)
data/packstate/
